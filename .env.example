# Copy this file to .env and fill in the values (see README).
# Supabase — same project as web (dadhealth-prod).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public marketing/app site opened from the Profile screen.
EXPO_PUBLIC_WEB_URL=https://www.dadhealth.co.uk

# OneSignal public app identifier used by native builds.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Native Dad Health Pro products (must exactly match App Store Connect / Google Play).
EXPO_PUBLIC_APPLE_IAP_PRO_MONTHLY_PRODUCT_ID=
EXPO_PUBLIC_APPLE_IAP_PRO_ANNUAL_PRODUCT_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PRO_PRODUCT_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PRO_MONTHLY_BASE_PLAN_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PRO_ANNUAL_BASE_PLAN_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PRO_MONTHLY_TRIAL_OFFER_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PRO_ANNUAL_TRIAL_OFFER_ID=

# Optional product analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
