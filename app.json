{
  "expo": {
    "name": "Dad Health",
    "slug": "dadhealth-mobile",
    "version": "1.0.0",
    "scheme": "dadhealth",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0A0A0A",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.uk.dadhealth",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.co.uk.dadhealth.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "co.uk.dadhealth",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Dad Health reads your steps, exercise minutes, resting heart rate and sleep to update your Fitness and Progress data.",
          "NSHealthUpdateUsageDescription": "Dad Health does not write data to Apple Health.",
          "background": false
        }
      ],
      "./plugins/withHealthConnectPrivacy",
      "react-native-health-connect",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dad Health to use Face ID to log you in."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Dad Health to use your location to find nearby Dad Days."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "186b0d8f-cfd3-48ce-991f-7bba7cfcba88"
      }
    },
    "owner": "dadhealth-01"
  }
}
