{
  "expo": {
    "name": "dadHealth",
    "slug": "dadhealth-mobile",
    "version": "1.0.0",
    "scheme": "dadhealth",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0A0A0A",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.uk.dadhealth",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "co.uk.dadhealth",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dad Health to use Face ID to log you in."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Dad Health to use your location to find nearby Dad Days."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "186b0d8f-cfd3-48ce-991f-7bba7cfcba88"
      }
    },
    "owner": "dadhealth-01"
  }
}
